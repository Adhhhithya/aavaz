// Prisma schema for the S4 identity/OTP/victim-authentication slice only.
//
// Produced from REAL introspection (`prisma db pull`) against an isolated,
// throwaway PostgreSQL 17 instance with `backend/schema.sql` and
// `backend/migrations/0002_otp_codes.sql` applied — the same two files that
// would be applied to a real Supabase project. Full introspection revealed
// all 7 existing tables and 9 enums; only the two tables this slice's code
// actually reads/writes (`users`, `otp_codes`) are modeled here on purpose.
// See docs/S4_IDENTITY_MIGRATION.md for the full mapping and rationale.
//
// KNOWN LIMITATION discovered during introspection: Prisma silently omits
// partial indexes (`CREATE INDEX ... WHERE ...`) from `db pull` output. The
// migration's `idx_otp_codes_ip_hash_created` (`WHERE ip_hash IS NOT NULL`)
// exists and functions in Postgres — Prisma just doesn't represent or manage
// it. This is not something to fix; it's a documented tool limitation.
//
// Every other table (`cases`, `interactions`, `counsellors`, `sos_events`,
// `case_updates`) exists in the same database but is deliberately NOT
// modeled here — this slice has no owning logic for them yet.
//
// S5 UPDATE: `cases` and `counsellors` were added below via a SECOND real
// introspection pass (same technique — throwaway Postgres with
// backend/schema.sql plus every migration through
// backend/migrations/0003_counsellor_caseload_cap.sql applied, then
// `prisma db pull`), because S5 (registration parity) needs Node to create
// case rows and run counsellor assignment. See
// docs/S5_REGISTRATION_MIGRATION.md for the full mapping and rationale.
// `interactions`, `sos_events`, and `case_updates` remain deliberately NOT
// modeled — this slice still has no owning logic for them. Because `cases`
// has real foreign keys to those three unmodeled tables, this schema is
// intentionally partial: only the referencing side needed by this slice
// (`cases` -> `users`, `cases` -> `counsellors`) is declared, exactly the
// same "model only what this slice owns" pattern already used for
// `otp_codes`/`users` in S4.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Matches schema.sql's role_type_enum exactly (used by users.role_type).
enum RoleType {
  victim
  witness
  family

  @@map("role_type_enum")
}

// Matches schema.sql's lang_enum exactly (used by users.preferred_language).
enum PreferredLanguage {
  hi
  ta
  ml
  en

  @@map("lang_enum")
}

// Matches schema.sql's location_source_enum exactly.
enum LocationSource {
  ivr
  sms
  app

  @@map("location_source_enum")
}

// Maps to the existing `users` table (backend/schema.sql). Node does not
// create, own, or migrate this table's DDL in this slice — it only reads and
// inserts rows via Prisma, using the exact same table Python's
// `services/supabase_client.py`-based code already writes. This is
// deliberately the SAME table, not a duplicate (Phase 3 requirement).
//
// Only identity-relevant behavior is implemented in this slice: the
// location_*/consent_* columns are carried through unmodified because
// registration accepts them today, but no logic in this slice computes or
// validates them (that stays wherever `profile-case` logic lives until that
// domain is extracted).
model User {
  id                String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  phoneNumber       String            @unique @map("phone_number")
  name              String
  roleType          RoleType          @map("role_type")
  preferredLanguage PreferredLanguage @map("preferred_language")
  consentGiven      Boolean?          @default(false) @map("consent_given")
  consentTimestamp  DateTime?         @map("consent_timestamp") @db.Timestamptz(6)
  locationDistrict  String?           @map("location_district")
  locationState     String?           @map("location_state")
  locationSource    LocationSource?   @map("location_source")
  locationLat       Float?            @map("location_lat")
  locationLng       Float?            @map("location_lng")
  createdAt         DateTime?         @default(now()) @map("created_at") @db.Timestamptz(6)
  // Reverse side of Case.user — Prisma requires both sides of a relation to
  // be declared once both related models are present in the schema. Added
  // in S5; does not change any column on `users`.
  cases             Case[]

  @@map("users")
}

// Maps to the existing `otp_codes` table (backend/migrations/0002_otp_codes.sql,
// introduced in S2). Node reuses this table as-is — no duplicate OTP storage
// was created, per Phase 3's explicit instruction. Column names, types,
// defaults, and the two representable indexes match the live-introspected
// schema exactly.
model OtpCode {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  phoneHash   String    @map("phone_hash")
  codeHash    String    @map("code_hash")
  salt        String
  purpose     String    @default("login")
  ipHash      String?   @map("ip_hash")
  attempts    Int       @default(0)
  maxAttempts Int       @default(3) @map("max_attempts")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phoneHash, createdAt(sort: Desc)], map: "idx_otp_codes_phone_hash_created")
  @@index([phoneHash, purpose, createdAt(sort: Desc)], map: "idx_otp_codes_phone_purpose_created")
  @@map("otp_codes")
}

// Matches schema.sql's intake_channel_enum exactly (used by cases.intake_channel).
enum IntakeChannel {
  nhaa_sim
  fir_sim
  ivr
  app
  sms
  chatbot

  @@map("intake_channel_enum")
}

// Matches schema.sql's case_stage_enum exactly (used by cases.case_stage).
// This is the OLD 6-stage enum, not the v0.2 11-state lifecycle machine
// (PENDING_CONSENT / REGISTERED / VERIFIED / MONITORING / ESCALATED /
// REFERRED / PAUSED / CLOSING / CLOSED / OPTED_OUT / PURGED) — see
// docs/S5_REGISTRATION_MIGRATION.md Phase 2 for why migrating the lifecycle
// enum is explicitly deferred, not silently done here.
enum CaseStage {
  registered
  investigation
  trial
  compensation
  rehabilitation
  closed

  @@map("case_stage_enum")
}

// Maps to the existing `cases` table (backend/schema.sql). Same "extend the
// real table, don't duplicate it" approach as User/OtpCode in S4. Only the
// columns/relations this slice's registration flow reads or writes are
// modeled — `cnr` and `ecourts_data` are NOT modeled because (a)
// schema.sql/introspection of a clean database don't define them at all
// (confirmed live-schema drift, same caveat already recorded in S3/S4 —
// backend/api/cases/ecourts_routes.py writes them, but that endpoint's
// migration is out of this slice's scope) and (b) registration never sets
// them in either implementation. `interactions`/`sos_events`/`case_updates`
// reverse relations are likewise not modeled — see the file header.
model Case {
  id                   String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId               String?        @map("user_id") @db.Uuid
  caseType             String         @map("case_type")
  intakeChannel        IntakeChannel  @map("intake_channel")
  caseStage            CaseStage?     @default(registered) @map("case_stage")
  assignedCounsellorId String?        @map("assigned_counsellor_id") @db.Uuid
  currentDistressScore Float?         @default(0.0) @map("current_distress_score")
  priorityRank         Int?           @default(0) @map("priority_rank")
  createdAt            DateTime?      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime?      @default(now()) @map("updated_at") @db.Timestamptz(6)
  user                 User?          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  counsellor           Counsellor?    @relation(fields: [assignedCounsellorId], references: [id], onUpdate: NoAction)

  @@index([assignedCounsellorId], map: "idx_cases_assigned_counsellor_id")
  @@index([caseStage], map: "idx_cases_case_stage")
  @@index([currentDistressScore], map: "idx_cases_current_distress_score")
  // schema.sql defines this as a second, functionally-duplicate index on the
  // same single column (its own comment even says "Needs join logic for
  // district" — it isn't one yet). Modeled anyway for introspection fidelity
  // — Node did not invent or remove this; it's exactly what's in the DB.
  @@index([currentDistressScore], map: "idx_cases_district_score")
  @@map("cases")
}

// Maps to the existing `counsellors` table (backend/schema.sql), PLUS the
// `caseload_cap` column added by
// backend/migrations/0003_counsellor_caseload_cap.sql (S5). Real
// introspection was re-run with that migration applied — `caseload_cap` is
// not a value invented in this Prisma file, it is a real, NOT NULL, DEFAULT
// 80 column confirmed to exist against a real Postgres instance.
model Counsellor {
  id               String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name             String
  district         String
  languages        String[]
  currentCaseload  Int?    @default(0) @map("current_caseload")
  caseloadCap      Int     @default(80) @map("caseload_cap")
  cases            Case[]

  @@index([district, currentCaseload], map: "idx_counsellors_district_caseload")
  @@map("counsellors")
}
