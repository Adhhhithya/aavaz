# Must be "production" in any real deployment; defaults to "development" if
# unset. Gates the synthetic OTP provider and the insecure dev secret
# fallbacks in otp.service.ts / token.service.ts — mirrors backend/.env.example.
NODE_ENV=development

PORT=3001

# Points at the SAME Postgres database the existing Python backend uses.
# This service does not create or require a separate database — see
# docs/S4_IDENTITY_MIGRATION.md.
DATABASE_URL="postgresql://user:password@localhost:5432/aavaz?schema=public"

# Victim OTP authentication. Required in any non-development environment.
# NOTE: if this Node service and the existing Python backend are ever live
# against the same otp_codes table at the same time, they must be given the
# SAME pepper or an OTP issued by one cannot be verified by the other — see
# the "Shared secret / dual-authority risk" note in
# docs/S4_IDENTITY_MIGRATION.md before configuring this for anything beyond
# isolated testing.
OTP_PEPPER=

# Signing secret for victim session / phone-verified tokens. Same
# same-value-across-services caveat as OTP_PEPPER applies.
VICTIM_SESSION_SECRET=
