# Must be "production" in any real deployment. Gates destructive dev-only
# utilities (see scripts/clear_db.py) so they refuse to run outside development.
ENVIRONMENT=development

SUPABASE_URL=https://<your-supabase-project-id>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>
BOLNA_API_KEY=<your-bolna-api-key>
PUSHBULLET_API_KEY=<your-pushbullet-api-key>
GROQ_API_KEY=<your-groq-api-key>
NGROK_URL=https://<your-ngrok-domain>.ngrok-free.dev
ECOURTS_API_KEY=<your-ecourts-api-key>

# Interim shared-secret webhook checks (S1/S2) — NOT a real Bolna/Pushbullet
# signature scheme, see api/auth/webhook_auth.py. Required in any non-development
# environment; requests are rejected (503) if unset outside development.
BOLNA_WEBHOOK_SECRET=<a-long-random-shared-secret>
PUSHBULLET_WEBHOOK_SECRET=<a-long-random-shared-secret>

# Victim OTP authentication (S2). Required in any non-development environment —
# see backend/config.py and services/otp_service.py for the development fallback.
OTP_PEPPER=<a-long-random-secret-distinct-from-the-others-here>
VICTIM_SESSION_SECRET=<a-long-random-secret-distinct-from-the-others-here>
